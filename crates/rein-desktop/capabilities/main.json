{
  "identifier": "main",
  "description": "The only capability. The main window may call the IPC command table (desktop.md §API) and listen for core events. No shell, fs, http or opener plugin.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-tab-open",
    "allow-pty-write",
    "allow-pty-resize",
    "allow-pty-ack",
    "allow-tab-detach",
    "allow-tab-tmux",
    "allow-clipboard-write",
    "allow-dir-complete",
    "allow-config-get",
    "allow-projects-list",
    "allow-projects-forget",
    "allow-health-get",
    "allow-release-check",
    "allow-release-apply",
    "allow-profiles-plan",
    "allow-profiles-apply",
    "allow-project-choose",
    "allow-clipboard-read",
    "allow-ui-get",
    "allow-ui-set",
    "allow-panel-data",
    "allow-project-agents",
    "allow-project-close",
    "allow-project-check",
    "allow-project-setup",
    "allow-project-fix",
    "allow-project-fix-cancel",
    "core:window:allow-close",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize"
  ]
}
